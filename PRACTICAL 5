#include <iostream>
using namespace std;

class Average
{
Public:
    void average(int a, int b)
    {
        cout << "Average of two numbers = "
             << (a + b) / 2.0 << endl;
    }

    void average(int a, int b, int c)
    {
        cout << "Average of three numbers = "
             << (a + b + c) / 3.0 << endl;
    }
};

int main()
{
    Average obj;

    obj.average(10, 20);
    obj.average(10, 20, 30);
     return 0;
     }        
