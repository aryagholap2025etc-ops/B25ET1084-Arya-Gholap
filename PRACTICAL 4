#include <iostream>
using namespace std;

class Complex
{
    float real, imag;

public:
    void getData()
    {
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    void square()
 {
        float r, i;

        r = (real * real) - (imag * imag);
        i = 2 * real * imag;
      cout << "Square = " << r << " + " << i << "i";
    }
    };

    int main()
{
    Complex c;
 c.getData();
    c.square();

    return 0;
}


