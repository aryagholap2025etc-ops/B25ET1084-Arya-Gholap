#include <iostream>
using namespace std;

class Product
{
public:
    virtual void calculatePrice()
    {
        cout << "Product price" << endl;
    }
};

class Electronics : public Product
{
public:
    void calculatePrice() override
    {
        cout << "Electronics price: Rs. 15000" << endl;
    }
};

class Clothing : public Product
{
public:
    void calculatePrice() override
    {
        cout << "Clothing price: Rs. 1000" << endl;
    }
};

int main()
{
    Product *p;

    Electronics e;
    Clothing c;

    p = &e;
    p->calculatePrice();

    p = &c;
    p->calculatePrice();

    return 0;
}
